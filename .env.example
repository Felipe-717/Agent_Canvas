# Plantilla de configuracion. Copiar a `.env` y rellenar.
#
#     copy .env.example .env
#
# El `.env` esta en .gitignore y no se versiona nunca.
#
# Lo unico obligatorio es LLM_API_KEY. Todo lo demas tiene un valor por defecto
# razonable en src/agentcanvas/config.py; estas lineas solo estan aqui para que
# se vea que existe y se pueda cambiar sin bucear en el codigo.

DEBUG=false

# --- LLM: lo unico que hay que rellenar ---------------------------------
# Clave de https://platform.openai.com/api-keys
LLM_API_KEY=

LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.6-luna

# none | low | medium | high | xhigh | max
# "low" basta para producir la especificacion de un grafico y mantiene el coste
# y la latencia abajo. gpt-5.6-luna: $0.20 por millon de tokens de entrada,
# $1.20 de salida, $0.02 si la entrada viene de cache.
LLM_REASONING_EFFORT=low

# Rol separado para generar Python, que es la tarea que mas capacidad exige.
# Vacio = usa LLM_MODEL. Si algun dia el codigo generado falla demasiado, aqui
# se sube a un modelo mayor sin encarecer el resto.
LLM_CODEGEN_MODEL=
LLM_CODEGEN_REASONING_EFFORT=high

LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# --- Migrar a un modelo open-source servido con vLLM --------------------
# Descomentar estas tres lineas y comentar las de arriba. Nada mas del sistema
# se entera del cambio: las capacidades del modelo se resuelven solas en
# src/agentcanvas/infrastructure/llm/capabilities.py
#
#   vllm serve Qwen/Qwen3-32B-Instruct --port 8000
#
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=dummy
# LLM_MODEL=Qwen/Qwen3-32B-Instruct

# --- Almacenamiento -----------------------------------------------------
# Vacio o ausente = SQLite y archivos dentro de var/, con ruta absoluta
# resuelta sola. var/ esta en .gitignore.
# DATA_DIR=
# DATABASE_URL=

# MVP monousuario: no hay login. Este id queda grabado en cada dataset para que
# anadir multiusuario mas adelante no obligue a migrar todas las tablas.
DEFAULT_OWNER_ID=local-user

# --- Limites del agente -------------------------------------------------
# Un agente sin limite explicito es una factura sin limite explicito.
AGENT_MAX_ITERATIONS=8
AGENT_MAX_REPAIR_ATTEMPTS=3

# --- Limites de ejecucion de codigo generado ----------------------------
EXECUTION_TIMEOUT_SECONDS=60
EXECUTION_MAX_OUTPUT_BYTES=1000000
