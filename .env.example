# Copiar a .env y rellenar. El .env nunca se versiona.

DEBUG=false

# --- LLM ---------------------------------------------------------------
# API oficial de OpenAI:
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-5.6-luna
LLM_REASONING_EFFORT=low

# Modelo para generar Python (mas exigente). Vacio = usa LLM_MODEL.
LLM_CODEGEN_MODEL=
LLM_CODEGEN_REASONING_EFFORT=high

# --- Migrar a un modelo open-source servido con vLLM --------------------
# Solo hay que cambiar estas tres lineas; el resto del sistema no se entera.
#   vllm serve Qwen/Qwen3-32B-Instruct --port 8000 --enable-auto-tool-choice
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=dummy
# LLM_MODEL=Qwen/Qwen3-32B-Instruct

# --- Almacenamiento -----------------------------------------------------
# Vacio o ausente = SQLite en var/agentcanvas.db (ruta absoluta, resuelta sola).
# DATABASE_URL=

# --- Limites de ejecucion ----------------------------------------------
EXECUTION_TIMEOUT_SECONDS=60
AGENT_MAX_ITERATIONS=8
AGENT_MAX_REPAIR_ATTEMPTS=3
